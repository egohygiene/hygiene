{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/repository-documentation-inventory.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "visibility",
    "repository",
    "as_of",
    "layout",
    "readme_mode",
    "readme_justification",
    "claude_selected",
    "documents",
    "architecture_selected",
    "layout_exception"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.repository-documentation-inventory/v1"
    },
    "visibility": {
      "enum": [
        "public",
        "internal",
        "private",
        "unknown"
      ]
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "lifecycle",
        "repository_type",
        "presentation_lifecycle"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^egohygiene/(?:\\.github|[a-z0-9][a-z0-9.-]*)$"
        },
        "kind": {
          "enum": [
            "standard",
            "mirror",
            "generated-only",
            "template",
            "unknown"
          ]
        },
        "lifecycle": {
          "enum": [
            "active",
            "dormant",
            "archived",
            "unknown"
          ]
        },
        "repository_type": {
          "enum": [
            "application",
            "collection",
            "control_plane",
            "documentation",
            "infrastructure",
            "library",
            "publication",
            "template",
            "tool",
            "website",
            "unknown"
          ]
        },
        "presentation_lifecycle": {
          "enum": [
            "active",
            "incubating",
            "archived",
            "unknown"
          ]
        }
      }
    },
    "as_of": {
      "type": "string",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "layout": {
      "enum": [
        "legacy-root",
        "nested-architecture",
        "repository-exception",
        "unknown"
      ]
    },
    "readme_mode": {
      "enum": [
        "concise",
        "rich-justified",
        "unknown"
      ]
    },
    "readme_justification": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        }
      ]
    },
    "claude_selected": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "documents": {
      "type": "array",
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/document"
      }
    },
    "architecture_selected": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "layout_exception": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/layout_exception"
        }
      ]
    }
  },
  "$defs": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "category",
        "path",
        "authority",
        "ownership",
        "state",
        "file_kind",
        "links"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,63}$"
        },
        "category": {
          "enum": [
            "readme",
            "agents",
            "continuity",
            "claude",
            "architecture_navigation",
            "documentation_index",
            "architecture",
            "purpose",
            "decisions",
            "guide",
            "reference",
            "design",
            "evidence",
            "work_report",
            "archive",
            "temporary"
          ]
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240,
          "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*/$)(?!.*(?:^|/)(?:\\.{1,2}|\\.[gG][iI][tT])(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+$"
        },
        "authority": {
          "enum": [
            "canonical",
            "navigation",
            "derived",
            "historical",
            "scratch"
          ]
        },
        "ownership": {
          "enum": [
            "repository",
            "generated"
          ]
        },
        "state": {
          "enum": [
            "present",
            "missing",
            "unknown",
            "inaccessible"
          ]
        },
        "file_kind": {
          "enum": [
            "regular",
            "symlink",
            "directory",
            "unknown"
          ]
        },
        "links": {
          "type": "array",
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*/$)(?!.*(?:^|/)(?:\\.{1,2}|\\.[gG][iI][tT])(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+$"
          }
        },
        "stable_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]{0,127}$"
            }
          ]
        },
        "canonical_id": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          ]
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "update_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "revision",
            "path"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
            },
            "revision": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "path": {
              "type": "string",
              "minLength": 1,
              "maxLength": 240,
              "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*/$)(?!.*(?:^|/)(?:\\.{1,2}|\\.[gG][iI][tT])(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+$"
            }
          }
        },
        "imports": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*/$)(?!.*(?:^|/)(?:\\.{1,2}|\\.[gG][iI][tT])(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+$"
          }
        },
        "first_nonblank_line": {
          "type": "string",
          "maxLength": 256,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*$"
        },
        "provider_content": {
          "type": "boolean"
        },
        "justification": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
            }
          ]
        },
        "durable": {
          "type": "boolean"
        },
        "tracked": {
          "type": "boolean"
        }
      }
    },
    "layout_exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "owner",
        "reason",
        "review_trigger",
        "paths"
      ],
      "properties": {
        "status": {
          "const": "proposed"
        },
        "owner": {
          "type": "string",
          "pattern": "^egohygiene/(?:\\.github|[a-z0-9][a-z0-9.-]*)$"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "review_trigger": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^[^\\u0000-\\u001f\\u007f]*\\S[^\\u0000-\\u001f\\u007f]*$"
        },
        "paths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "canonical_id",
              "path"
            ],
            "properties": {
              "canonical_id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]{0,63}$"
              },
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 240,
                "pattern": "^(?!/)(?![A-Za-z]:)(?!.*//)(?!.*/$)(?!.*(?:^|/)(?:\\.{1,2}|\\.[gG][iI][tT])(?:/|$))[^\\\\\\u0000-\\u001f\\u007f]+$"
              }
            }
          }
        }
      }
    }
  },
  "title": "Explicit repository documentation observations; not filesystem or public-source proof",
  "allOf": [
    {
      "if": {
        "properties": {
          "layout": {
            "const": "repository-exception"
          }
        }
      },
      "then": {
        "properties": {
          "layout_exception": {
            "$ref": "#/$defs/layout_exception"
          }
        }
      },
      "else": {
        "properties": {
          "layout_exception": {
            "type": "null"
          }
        }
      }
    }
  ]
}
