{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/hygiene/dependency-boundary-register.v1.schema.json",
  "title": "Ego Hygiene dependency-boundary register v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "architecture_release",
    "organization",
    "canonical_repository",
    "governed_by",
    "default_policy",
    "rules",
    "relationships",
    "forbidden_dependencies",
    "exceptions"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "architecture_release": {
      "type": "string",
      "pattern": "^architecture-v[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "organization": {
      "const": "egohygiene"
    },
    "canonical_repository": {
      "const": "egohygiene/hygiene"
    },
    "governed_by": {
      "$ref": "#/$defs/nonEmptyUniqueStrings"
    },
    "default_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration",
        "pinning",
        "copied_sibling_source",
        "mutable_default_branch",
        "unknown_dependency"
      ],
      "properties": {
        "integration": {
          "const": "versioned-public-contract"
        },
        "pinning": {
          "const": "immutable-or-versioned"
        },
        "copied_sibling_source": {
          "const": "forbidden"
        },
        "mutable_default_branch": {
          "const": "forbidden"
        },
        "unknown_dependency": {
          "const": "deny"
        }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/rule"
      }
    },
    "relationships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relationship"
      }
    },
    "forbidden_dependencies": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/forbiddenDependency"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exception"
      }
    }
  },
  "$defs": {
    "nonEmptyUniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repository": {
      "type": "string",
      "pattern": "^egohygiene/(\\*|\\.github|[a-z0-9][a-z0-9.-]*)$"
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "severity",
        "statement"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^BOUNDARY-[0-9]{3}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "error",
            "warning"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "producer",
        "consumers",
        "capability",
        "interfaces",
        "contract",
        "contract_status",
        "pinning"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^RELATIONSHIP-[0-9]{3}$"
        },
        "producer": {
          "$ref": "#/$defs/repository"
        },
        "consumers": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repository"
          }
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "interfaces": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "api",
              "binary",
              "generated-projection",
              "oci-image",
              "package",
              "reusable-workflow",
              "schema"
            ]
          }
        },
        "contract": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "contract_status": {
          "enum": [
            "active",
            "required"
          ]
        },
        "pinning": {
          "enum": [
            "immutable",
            "immutable-or-versioned",
            "versioned"
          ]
        }
      }
    },
    "forbiddenDependency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "target",
        "rule",
        "reason"
      ],
      "properties": {
        "source": {
          "$ref": "#/$defs/repository"
        },
        "target": {
          "$ref": "#/$defs/repository"
        },
        "rule": {
          "type": "string",
          "pattern": "^BOUNDARY-[0-9]{3}$"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "exception": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "rule",
        "owner",
        "reason",
        "status",
        "approval",
        "expires_on",
        "affected_repositories"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^EXCEPTION-[0-9]{3}$"
        },
        "rule": {
          "type": "string",
          "pattern": "^BOUNDARY-[0-9]{3}$"
        },
        "owner": {
          "$ref": "#/$defs/repository"
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "approved",
            "expired",
            "proposed"
          ]
        },
        "approval": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "expires_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "affected_repositories": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/repository"
          }
        }
      }
    }
  }
}
