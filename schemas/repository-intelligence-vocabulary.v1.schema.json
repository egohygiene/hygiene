{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/hygiene/repository-intelligence-vocabulary.v1.schema.json",
  "title": "Ego Hygiene Repository Intelligence relationship vocabulary v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "owner",
    "relationship_types"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.repository-intelligence-vocabulary/v1"
    },
    "version": {
      "const": "1.0.0-alpha.1"
    },
    "status": {
      "enum": ["proposed", "active", "deprecated"]
    },
    "owner": {
      "const": "egohygiene/hygiene"
    },
    "relationship_types": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/relationshipType"
      }
    }
  },
  "$defs": {
    "entityKind": {
      "enum": [
        "repository",
        "roadmap_step",
        "architecture_decision",
        "issue",
        "pull_request",
        "commit",
        "check",
        "release",
        "deployment"
      ]
    },
    "relationshipType": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "description",
        "direction",
        "inverse",
        "cardinality",
        "source_kinds",
        "target_kinds",
        "transitive"
      ],
      "properties": {
        "type": {
          "enum": [
            "implements",
            "informs",
            "supersedes",
            "blocks",
            "depends-on",
            "releases",
            "deploys",
            "tracks",
            "verifies",
            "evidences"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "direction": {
          "const": "directed"
        },
        "inverse": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            {
              "type": "null"
            }
          ]
        },
        "cardinality": {
          "enum": ["one-to-one", "one-to-many", "many-to-one", "many-to-many"]
        },
        "source_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityKind"
          }
        },
        "target_kinds": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/entityKind"
          }
        },
        "transitive": {
          "type": "boolean"
        }
      }
    }
  }
}
