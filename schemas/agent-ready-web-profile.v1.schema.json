{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/hygiene/agent-ready-web-profile.v1.schema.json",
  "title": "Ego Hygiene Agent-Ready Web profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "owner",
    "updated",
    "purpose",
    "concern_policy",
    "concerns",
    "site_classes",
    "requirement_strengths",
    "maturity_levels",
    "mechanism_contract",
    "mechanisms",
    "compatibility",
    "extensions",
    "ownership"
  ],
  "properties": {
    "schema": {
      "const": "egohygiene.agent-ready-web-profile/v1"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "status": {
      "enum": [
        "proposed",
        "active",
        "deprecated",
        "superseded"
      ]
    },
    "owner": {
      "const": "egohygiene/hygiene"
    },
    "updated": {
      "type": "string",
      "format": "date"
    },
    "purpose": {
      "$ref": "#/$defs/text"
    },
    "concern_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "primary_concern_cardinality",
        "independent_requirement_resolution",
        "cross_concern_inference"
      ],
      "properties": {
        "primary_concern_cardinality": {
          "const": "exactly-one"
        },
        "independent_requirement_resolution": {
          "const": true
        },
        "cross_concern_inference": {
          "const": "forbidden"
        }
      }
    },
    "concerns": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/concern"
      }
    },
    "site_classes": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/siteClass"
      }
    },
    "requirement_strengths": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "$ref": "#/$defs/vocabularyEntry"
      }
    },
    "maturity_levels": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {
        "$ref": "#/$defs/maturityEntry"
      }
    },
    "mechanism_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier_pattern",
        "reference_types",
        "reference_authorities",
        "evidence_kinds",
        "evidence_scope",
        "site_conformance_evidence",
        "required_primary_references",
        "required_registration_evidence"
      ],
      "properties": {
        "identifier_pattern": {
          "const": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
        },
        "reference_types": {
          "const": [
            "standard",
            "industry-specification",
            "official-documentation",
            "registry",
            "maintainer-source"
          ]
        },
        "reference_authorities": {
          "const": [
            "primary",
            "supporting"
          ]
        },
        "evidence_kinds": {
          "const": [
            "specification-publication",
            "implementation-observation",
            "conformance-test",
            "adoption-observation",
            "maintainer-assessment"
          ]
        },
        "evidence_scope": {
          "const": "mechanism-registration-only"
        },
        "site_conformance_evidence": {
          "const": "deferred"
        },
        "required_primary_references": {
          "const": 1
        },
        "required_registration_evidence": {
          "const": 1
        },
        "concern_specific_bindings": {
          "const": [
            "capability",
            "commerce"
          ]
        }
      }
    },
    "resolution_policy": {
      "$ref": "#/$defs/resolutionPolicy"
    },
    "representation_policy": {
      "$ref": "#/$defs/representationPolicy"
    },
    "capability_policy": {
      "$ref": "#/$defs/capabilityPolicy"
    },
    "commerce_policy": {
      "$ref": "#/$defs/commercePolicy"
    },
    "mechanisms": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/mechanism"
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_major",
        "versioning",
        "consumer_pinning",
        "same_major_guarantee",
        "additive_changes",
        "breaking_changes",
        "unknown_core_values",
        "unknown_extensions"
      ],
      "properties": {
        "contract_major": {
          "const": 1
        },
        "versioning": {
          "const": "semantic-versioning"
        },
        "consumer_pinning": {
          "const": "exact-version-or-immutable-revision"
        },
        "same_major_guarantee": {
          "$ref": "#/$defs/text"
        },
        "additive_changes": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "breaking_changes": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "unknown_core_values": {
          "const": "fail-closed"
        },
        "unknown_extensions": {
          "const": "preserve-uninterpreted-and-exclude-from-core-conformance"
        }
      }
    },
    "extensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "identifier_pattern",
        "registered",
        "unknown_behavior",
        "allowed",
        "prohibited"
      ],
      "properties": {
        "identifier_pattern": {
          "const": "^egohygiene\\.[a-z0-9][a-z0-9.-]*\\.agent-ready-web\\.[a-z0-9][a-z0-9.-]*/v[0-9]+$"
        },
        "registered": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/registeredExtension"
          }
        },
        "unknown_behavior": {
          "const": "preserve-uninterpreted-and-exclude-from-core-conformance"
        },
        "allowed": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "prohibited": {
          "$ref": "#/$defs/uniqueStrings"
        }
      }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hygiene",
        "holon",
        "relay",
        "pace",
        "store",
        "observatory"
      ],
      "properties": {
        "hygiene": {
          "$ref": "#/$defs/ownershipBoundary"
        },
        "holon": {
          "$ref": "#/$defs/ownershipBoundary"
        },
        "relay": {
          "$ref": "#/$defs/ownershipBoundary"
        },
        "pace": {
          "$ref": "#/$defs/ownershipBoundary"
        },
        "store": {
          "$ref": "#/$defs/ownershipBoundary"
        },
        "observatory": {
          "$ref": "#/$defs/ownershipBoundary"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.0.0-alpha.2"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "required": [
          "resolution_policy",
          "representation_policy"
        ],
        "properties": {
          "mechanisms": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/catalogMechanism"
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "version": {
            "const": "1.0.0-alpha.3"
          }
        },
        "required": [
          "version"
        ]
      },
      "then": {
        "required": [
          "resolution_policy",
          "representation_policy",
          "capability_policy",
          "commerce_policy"
        ],
        "properties": {
          "mechanism_contract": {
            "required": [
              "concern_specific_bindings"
            ]
          },
          "mechanisms": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/catalogMechanism"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1
    },
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "location": {
      "type": "string",
      "anyOf": [
        {
          "format": "uri",
          "pattern": "^https://"
        },
        {
          "pattern": "^(?!\\.{1,2}(?:/|$))(?!.*\\/\\.{1,2}(?:/|$))(?:[A-Za-z0-9._-]+/)*[A-Za-z0-9._-]+$"
        }
      ]
    },
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "resolutionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "applicability_precedes_strength",
        "inapplicable_absence",
        "optional_absence",
        "recommended_absence",
        "conditional_absence",
        "required_absence",
        "prohibited_presence",
        "emerging_and_experimental_default",
        "fabricated_placeholder"
      ],
      "properties": {
        "applicability_precedes_strength": {
          "const": true
        },
        "inapplicable_absence": {
          "const": "valid"
        },
        "optional_absence": {
          "const": "valid"
        },
        "recommended_absence": {
          "const": "advisory"
        },
        "conditional_absence": {
          "const": "valid-when-condition-false"
        },
        "required_absence": {
          "const": "error"
        },
        "prohibited_presence": {
          "const": "error"
        },
        "emerging_and_experimental_default": {
          "const": "non-blocking"
        },
        "fabricated_placeholder": {
          "const": "prohibited"
        }
      }
    },
    "representationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "integrity",
        "content_negotiation",
        "alternate_discovery",
        "authoritative_references"
      ],
      "properties": {
        "scope": {
          "const": "public-source-equivalent-alternate-representations"
        },
        "integrity": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_source",
            "source_equivalence",
            "freshness",
            "canonical_url",
            "provenance",
            "access_control",
            "hidden_or_privileged_content",
            "drift"
          ],
          "properties": {
            "canonical_source": {
              "const": "shared-reviewed-source"
            },
            "source_equivalence": {
              "const": "no-material-additions-omissions-or-changed-claims"
            },
            "freshness": {
              "const": "same-build-or-source-revision"
            },
            "canonical_url": {
              "const": "human-facing-canonical-url"
            },
            "provenance": {
              "const": "record-source-uri-revision-generator-and-generated-at"
            },
            "access_control": {
              "const": "same-or-stricter-than-canonical"
            },
            "hidden_or_privileged_content": {
              "const": "prohibited"
            },
            "drift": {
              "const": "invalidate-present-alternate"
            }
          }
        },
        "content_negotiation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "canonical_default",
            "markdown_selection",
            "tie_or_wildcard",
            "unavailable_or_unacceptable",
            "vary",
            "content_location",
            "user_agent_selection"
          ],
          "properties": {
            "canonical_default": {
              "const": "text/html"
            },
            "markdown_selection": {
              "const": "only-when-accept-gives-text-markdown-a-higher-positive-quality-than-text-html"
            },
            "tie_or_wildcard": {
              "const": "text/html"
            },
            "unavailable_or_unacceptable": {
              "const": "text-html-if-acceptable-otherwise-406"
            },
            "vary": {
              "const": "Accept-required-when-selection-can-vary"
            },
            "content_location": {
              "const": "explicit-markdown-uri-required-for-negotiated-markdown"
            },
            "user_agent_selection": {
              "const": "prohibited"
            }
          }
        },
        "alternate_discovery": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "relation",
            "media_type",
            "html_or_http_link",
            "canonical_backlink"
          ],
          "properties": {
            "relation": {
              "const": "alternate"
            },
            "media_type": {
              "const": "text/markdown"
            },
            "html_or_http_link": {
              "const": "required"
            },
            "canonical_backlink": {
              "const": "human-facing-canonical-url-required"
            }
          }
        },
        "authoritative_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authoritativeReference"
          }
        }
      }
    },
    "capabilityPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "protocol_status",
        "declaration_contract",
        "classification",
        "security",
        "execution_evidence",
        "failure_policy",
        "publication_gate",
        "authoritative_references"
      ],
      "properties": {
        "scope": {
          "const": "browser-agent-tool-exposure"
        },
        "protocol_status": {
          "const": {
            "webmcp": "draft-community-group-report-not-a-web-standard",
            "mcp_b": "experimental-implementation-not-webmcp-or-mcp-authority"
          }
        },
        "declaration_contract": {
          "const": {
            "identity": "stable-origin-bound-capability-id",
            "protocol_revision": "exact-version-or-immutable-revision-required",
            "discovery": "protocol-native-active-authorized-context-plus-origin-bound-contract-evidence",
            "input_contract": "versioned-json-schema-and-runtime-validation-required",
            "output_contract": "versioned-json-schema-and-runtime-validation-required",
            "compatibility": "breaking-input-output-effect-or-permission-change-requires-new-capability-major",
            "unknown_fields": "fail-closed"
          }
        },
        "classification": {
          "const": {
            "classes": [
              "read-only",
              "state-changing"
            ],
            "unclassified": "treat-as-state-changing-and-deny",
            "read_only": {
              "state_effects": "prohibited",
              "sensitive_data": "explicit-permission-and-consent-required",
              "confirmation": "required-before-sensitive-disclosure"
            },
            "state_changing": {
              "effects": "declare-completely-before-consent",
              "permission": "explicit-operation-scoped",
              "confirmation": "fresh-human-confirmation-before-consequential-or-irreversible-effect",
              "retry": "no-automatic-retry-without-idempotency-or-new-confirmation"
            }
          }
        },
        "security": {
          "const": {
            "permission": "explicit-operation-scoped-and-revocable",
            "consent": "informed-specific-and-obtained-before-invocation",
            "least_privilege": "minimum-data-scope-and-duration",
            "origin_binding": "secure-exact-origin-and-current-document",
            "authentication": "required-when-human-ui-requires-authentication",
            "authorization": "server-revalidated-for-every-invocation",
            "credential_handling": "no-token-passthrough-or-secret-in-schema-description-output",
            "data_minimization": "request-and-return-only-necessary-data",
            "annotations": "untrusted-hints-never-authority",
            "prompt_injection": "tool-metadata-input-and-output-treated-as-untrusted"
          }
        },
        "execution_evidence": {
          "const": {
            "provenance": "record-capability-id-version-origin-actor-and-contract-digests",
            "audit": "tamper-evident-invocation-decision-result-and-confirmation-record",
            "observability": "correlation-id-status-latency-and-redacted-error",
            "revocation": "effective-before-next-invocation",
            "expiry": "permissions-consent-and-handles-expire-explicitly",
            "replay_protection": "nonce-or-idempotency-key-bound-to-actor-origin-action-and-expiry",
            "rate_limits": "declared-and-enforced-per-actor-origin-and-capability"
          }
        },
        "failure_policy": {
          "const": {
            "default": "deny-and-perform-no-state-change",
            "partial_failure": "report-observed-effects-and-do-not-claim-rollback",
            "recovery": "human-visible-resume-or-compensating-path-required",
            "timeouts": "bounded-and-cancelable",
            "unknown_or_stale_contract": "deny"
          }
        },
        "publication_gate": {
          "const": "experimental-capability-absence-is-non-blocking-and-present-exposure-must-pass-all-guards"
        },
        "authoritative_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authoritativeReference"
          }
        }
      }
    },
    "commercePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scope",
        "descriptive_metadata",
        "guarded_actions",
        "advertising",
        "separation",
        "authoritative_references"
      ],
      "properties": {
        "scope": {
          "const": "descriptive-commerce-and-advertising-boundaries"
        },
        "descriptive_metadata": {
          "const": {
            "media_type": "application/ld+json",
            "vocabulary": [
              "https://schema.org/Offer",
              "https://schema.org/Product"
            ],
            "visible_fact_parity": "required",
            "seller_identity": "evidence-backed-explicit-or-omitted",
            "availability_price_currency": "current-visible-and-source-backed",
            "potential_action": "descriptive-only-no-execution-authority"
          }
        },
        "guarded_actions": {
          "const": {
            "owner": "egohygiene/store",
            "capability_class": "state-changing",
            "contract": "versioned-store-owned-contract-required",
            "metadata_authority": "none",
            "missing_contract": "do-not-expose-or-invoke",
            "confirmation": "agent-ready-web-capability-policy-required",
            "recovery": "store-contract-plus-agent-ready-web-failure-policy-required"
          }
        },
        "advertising": {
          "const": {
            "ads_txt_applicability": "actual-web-programmatic-inventory-authorization-or-explicit-iab-no-seller-declaration",
            "app_ads_txt_applicability": "distributed-app-programmatic-inventory-linked-to-developer-domain-or-explicit-iab-no-seller-declaration",
            "relationship_evidence": "current-publisher-and-ad-system-account-evidence-required",
            "direct_or_reseller": "must-match-real-contractual-account-relationship",
            "owner_manager_and_partner_domains": "must-match-current-documented-relationship",
            "no_relationships": "artifact-absent-with-explicit-not-applicable-evidence-or-exact-iab-no-seller-placeholder",
            "placeholder": "iab-reserved-sentinel-only-never-a-seller-relationship",
            "invented_relationships": "prohibited",
            "absence": "valid-when-inapplicable"
          }
        },
        "separation": {
          "const": {
            "metadata_to_capability_inference": "forbidden",
            "advertising_to_commerce_action": "forbidden",
            "offer_to_purchase_authority": "forbidden"
          }
        },
        "authoritative_references": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/authoritativeReference"
          }
        }
      }
    },
    "capabilityBinding": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "mcp-b"
              }
            },
            "required": [
              "protocol"
            ]
          },
          "then": {
            "properties": {
              "protocol_revision": {
                "const": "package-release-or-immutable-repository-revision"
              },
              "discovery_surface": {
                "const": "mcp-b-runtime-or-bridge-tool-list"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "protocol": {
                "const": "webmcp"
              }
            },
            "required": [
              "protocol"
            ]
          },
          "then": {
            "properties": {
              "protocol_revision": {
                "const": "2026-09-10-community-group-draft"
              },
              "discovery_surface": {
                "const": "document.modelContext-active-document-tool-list"
              }
            }
          }
        }
      ],
      "required": [
        "protocol",
        "protocol_revision",
        "implementation_pin",
        "identity",
        "discovery_surface",
        "classes",
        "input_contract",
        "output_contract",
        "compatibility"
      ],
      "properties": {
        "protocol": {
          "enum": [
            "mcp-b",
            "webmcp"
          ]
        },
        "protocol_revision": {
          "$ref": "#/$defs/text"
        },
        "implementation_pin": {
          "const": "exact-version-or-immutable-revision"
        },
        "identity": {
          "const": "stable-origin-bound-capability-id"
        },
        "discovery_surface": {
          "$ref": "#/$defs/text"
        },
        "classes": {
          "const": [
            "read-only",
            "state-changing"
          ]
        },
        "input_contract": {
          "const": "versioned-json-schema-and-runtime-validation-required"
        },
        "output_contract": {
          "const": "versioned-json-schema-and-runtime-validation-required"
        },
        "compatibility": {
          "const": "breaking-change-requires-new-capability-major"
        }
      }
    },
    "commerceBinding": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "role": {
                "const": "advertising-authorization-declaration"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "identity_source": {
                "enum": [
                  "publisher-and-advertising-system-contract-evidence",
                  "verified-app-store-developer-domain-and-advertising-system-contract-evidence"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "role": {
                "const": "descriptive-product-offer"
              }
            },
            "required": [
              "role"
            ]
          },
          "then": {
            "properties": {
              "identity_source": {
                "const": "canonical-human-facing-product-and-offer-source"
              }
            }
          }
        }
      ],
      "required": [
        "role",
        "identity_source",
        "executable_authority",
        "transaction_contract"
      ],
      "properties": {
        "role": {
          "enum": [
            "advertising-authorization-declaration",
            "descriptive-product-offer"
          ]
        },
        "identity_source": {
          "$ref": "#/$defs/text"
        },
        "executable_authority": {
          "const": "none"
        },
        "transaction_contract": {
          "const": "store-owned-versioned-contract-required-for-actions"
        }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
