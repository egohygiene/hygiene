            "properties": {
              "concern": {
                "enum": [
                  "readability",
                  "efficiency"
                ]
              }
            },
            "required": [
              "concern"
            ]
          },
          "then": {
            "properties": {
              "capability": false,
              "commerce": false
            }
          }
        }
