{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://egohygiene.io/schemas/hygiene/repository-release-policy.v1.schema.json",
  "title": "Ego Hygiene repository release policy v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "status",
    "owner",
    "updated",
    "purpose",
    "aether_contract",
    "requirements",
    "adoption_states",
    "repository_profiles",
    "lifecycles",
    "visibilities",
    "slots",
    "profile_overrides",
    "lifecycle_overrides",
    "visibility_overrides",
    "migration",
    "examples",
    "ownership"
  ],
  "properties": {
    "schema": { "const": "egohygiene.repository-release-policy/v1" },
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-alpha\\.[0-9]+)?$" },
    "status": { "enum": ["proposed", "active", "deprecated", "superseded"] },
    "owner": { "const": "egohygiene/hygiene" },
    "updated": { "type": "string", "format": "date" },
    "purpose": { "$ref": "#/$defs/text" },
    "aether_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "repository", "revision", "specification", "schema_url", "authoring_skill"],
      "properties": {
        "id": { "const": "egohygiene.repository-release/v1" },
        "version": { "const": "1.0.0" },
        "repository": { "const": "egohygiene/aether" },
        "revision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "specification": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
        "schema_url": { "const": "https://egohygiene.io/schemas/aether/repository-release/v1.json" },
        "authoring_skill": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "path", "url"],
          "properties": {
            "id": { "const": "prepare-repository-release" },
            "path": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$" },
            "url": { "type": "string", "format": "uri" }
          }
        }
      }
    },
    "requirements": {
      "const": ["required", "advisory", "not_applicable"]
    },
    "adoption_states": {
      "const": ["required", "advisory", "exempt", "not_applicable"]
    },
    "repository_profiles": { "$ref": "#/$defs/uniqueStrings" },
    "lifecycles": { "$ref": "#/$defs/uniqueStrings" },
    "visibilities": { "$ref": "#/$defs/uniqueStrings" },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/slot" }
    },
    "profile_overrides": { "$ref": "#/$defs/overrideMap" },
    "lifecycle_overrides": { "$ref": "#/$defs/overrideMap" },
    "visibility_overrides": { "$ref": "#/$defs/overrideMap" },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "new_repositories",
        "existing_active_repositories",
        "incubating_repositories",
        "legacy_history",
        "exceptions",
        "repository_facts"
      ],
      "properties": {
        "new_repositories": { "const": "required" },
        "existing_active_repositories": { "const": "required" },
        "incubating_repositories": { "const": "advisory" },
        "legacy_history": {
          "type": "object",
          "additionalProperties": false,
          "required": ["preserve_existing_tags", "preserve_existing_changelog", "invent_history_forbidden", "tag_rewrite_forbidden"],
          "properties": {
            "preserve_existing_tags": { "const": true },
            "preserve_existing_changelog": { "const": true },
            "invent_history_forbidden": { "const": true },
            "tag_rewrite_forbidden": { "const": true }
          }
        },
        "exceptions": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository_owned", "approval_required", "expiry_required", "required_fields"],
          "properties": {
            "repository_owned": { "const": true },
            "approval_required": { "const": true },
            "expiry_required": { "const": true },
            "required_fields": { "$ref": "#/$defs/uniqueStrings" }
          }
        },
        "repository_facts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["declaration_path", "external_registry_required", "one_source_of_truth"],
          "properties": {
            "declaration_path": { "const": ".egohygiene/release.json" },
            "external_registry_required": { "const": false },
            "one_source_of_truth": { "$ref": "#/$defs/text" }
          }
        }
      }
    },
    "examples": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/example" }
    },
    "ownership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["aether", "hygiene", "relay", "egolint", "pace", "repository"],
      "properties": {
        "aether": { "$ref": "#/$defs/text" },
        "hygiene": { "$ref": "#/$defs/text" },
        "relay": { "$ref": "#/$defs/text" },
        "egolint": { "$ref": "#/$defs/text" },
        "pace": { "$ref": "#/$defs/text" },
        "repository": { "$ref": "#/$defs/text" }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1 },
    "uniqueStrings": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/text" }
    },
    "requirement": { "enum": ["required", "advisory", "not_applicable"] },
    "slot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "default_requirement", "authority", "description", "checks"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
        "title": { "$ref": "#/$defs/text" },
        "default_requirement": { "$ref": "#/$defs/requirement" },
        "authority": { "type": "string", "pattern": "^(repository|egohygiene/[a-z0-9.-]+)$" },
        "description": { "$ref": "#/$defs/text" },
        "checks": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "overrideMap": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": { "$ref": "#/$defs/requirement" }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "repository_profile", "lifecycle", "visibility", "adoption_state", "notes"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
        "title": { "$ref": "#/$defs/text" },
        "repository_profile": { "$ref": "#/$defs/text" },
        "lifecycle": { "$ref": "#/$defs/text" },
        "visibility": { "$ref": "#/$defs/text" },
        "adoption_state": { "enum": ["required", "advisory", "exempt", "not_applicable"] },
        "notes": { "$ref": "#/$defs/text" }
      }
    }
  }
}
